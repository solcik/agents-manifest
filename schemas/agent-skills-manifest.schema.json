{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project agent skills manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "targets",
    "skills"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "targets": {
      "oneOf": [
        {
          "$ref": "#/$defs/targets"
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "all"
            }
          ],
          "minItems": 1,
          "maxItems": 1
        }
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "bundles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bundle"
      }
    }
  },
  "$defs": {
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "codex",
          "claude",
          "pi",
          "opencode",
          "hermes"
        ]
      }
    },
    "source": {
      "type": "string",
      "pattern": "^(https://|ssh://)[^\\s]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))[^/\\\\]+(?:/[^/\\\\]+)*$"
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source",
        "revision",
        "path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "targets": {
          "$ref": "#/$defs/targets"
        },
        "activation": {
          "const": "on-demand"
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "revision",
        "path"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "targets": {
          "$ref": "#/$defs/targets"
        }
      }
    }
  }
}
